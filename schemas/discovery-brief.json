{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Discovery Brief Schema",
  "description": "Validates discovery phase output for completeness and alignment",
  "required": [
    "end_state_definition",
    "client_technical_level",
    "stakeholder_map",
    "stated_needs",
    "unstated_needs",
    "edge_cases",
    "assumptions",
    "technical_constraints",
    "data_flow_overview",
    "security_requirements",
    "research_primer_summary"
  ],
  "properties": {
    "end_state_definition": {
      "type": "string",
      "minLength": 100,
      "description": "Detailed vision of what success looks like to the client"
    },
    "client_technical_level": {
      "type": "string",
      "enum": ["non_technical", "basic", "intermediate", "advanced"],
      "description": "Client's technical sophistication level"
    },
    "stakeholder_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "influence"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "influence": {"type": "string", "enum": ["high", "medium", "low"]},
          "priorities": {"type": "string"}
        }
      }
    },
    "stated_needs": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 20},
      "description": "What the client explicitly asked for"
    },
    "unstated_needs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 20},
      "description": "What the client needs but hasn't said"
    },
    "edge_cases": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 20},
      "description": "Boundary conditions and exceptional scenarios"
    },
    "assumptions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    },
    "technical_constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "data_flow_overview": {
      "type": "string",
      "minLength": 50,
      "description": "High-level data movement and dependencies"
    },
    "security_requirements": {
      "type": "array",
      "items": {"type": "string"}
    },
    "research_primer_summary": {
      "type": "object",
      "required": ["industry", "competitors", "technology", "client_profile"],
      "properties": {
        "industry": {"type": "string"},
        "competitors": {"type": "array", "items": {"type": "string"}},
        "technology": {"type": "array", "items": {"type": "string"}},
        "client_profile": {"type": "string"}
      }
    }
  }
}
